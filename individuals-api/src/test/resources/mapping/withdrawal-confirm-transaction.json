{
  "request": {
    "url": "/api/v1/transactions/confirm",
    "method": "POST",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.type",
          "contains": "WITHDRAWAL"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.userUid",
          "contains": "cccccccc-cccc-cccc-cccc-cccccccccccc"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.walletUid",
          "contains": "88888888-8888-8888-8888-888888888888"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "uid": "00000000-0000-0000-0000-000000000002",
      "userUid": "{{jsonPath request.body '$.userUid'}}",
      "walletUid": "{{jsonPath request.body '$.walletUid'}}",
      "amount": "40.44",
      "type": "{{jsonPath request.body '$.type'}}",
      "status": "PENDING",
      "fee": "0.33"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": [
      "response-template"
    ]
  }
}