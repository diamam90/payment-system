{
  "request": {
    "urlPathTemplate": "/api/v1/individuals/{individualId}",
    "method": "GET",
    "pathParameters": {
      "individualId": {
        "equalTo": "00000000-0000-0000-0000-000000000005"
      }
    }
  },
  "response": {
    "status": 404,
    "jsonBody": {
      "error": "Individual with id {{request.path.individualId}} not found",
      "status": 404
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": ["response-template"]
  }
}