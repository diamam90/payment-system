@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container(indApi,"individuals-api","Spring boot WebFlux")

Component(authController, "AuthController", "Rest Controller", "Обрабатывает http-запросы клиента")
Component(userService,"UserService","Сервис","Создание пользователя и получение информации")
Component(tokenService,"TokenService","Сервис","Логин и обновление токена")
Component(keycloak,"KeycloakClient", "WebClient Adapter","Взаимодействуют с Keycloak Rest API")
Component(dto, "DTO (сгенерированные)", "Open API DTO", "Сгенерированные модели запросов/ответов")
Component(keycloakDto, "DTO", "Keycloak API DTO", "Модели для взаимодействия с keycloak")

Rel(authController, userService, "вызов")
Rel(userService, tokenService, "вызов")
Rel(userService, keycloak, "вызов")
Rel(tokenService,keycloak, "вызов")
Rel(authController, dto, "использует")
Rel(keycloak, keycloakDto,"использует")

@enduml