{
  "request": {
    "urlPattern": "/api/v1/([a-z]*)",
    "method": "POST",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.externalId",
          "equalTo": "00000000-0000-0000-0000-000000000015"
        }
      }
    ]
  },
  "response": {
    "status": 201,
    "jsonBody": {
      "id": 1,
      "merchantId": 228,
      "amount": "{{jsonPath request.body '$.amount'}}",
      "status": "NOT SUCCESS",
      "externalId": "{{jsonPath request.body '$.externalId'}}"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": ["response-template"]
  }
}